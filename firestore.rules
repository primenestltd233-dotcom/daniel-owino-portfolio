rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "demmizkenya@gmail.com" ||
        request.auth.token.email == "danielowino233@gmail.com"
      );
    }

    // Public read for portfolio content
    match /settings/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /hero/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /about/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /education/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /skills/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /projects/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /experience/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /certificates/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /achievements/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /leadership/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /cv/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /blog/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /socials/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /media/{docId} { allow read: if true; allow write: if isAdmin(); }

    // Contact messages: anyone can create, only admin can read/write
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
