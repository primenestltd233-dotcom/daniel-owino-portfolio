rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read and write access for portfolio content & admin management
    match /settings/{docId} { allow read, write: if true; }
    match /hero/{docId} { allow read, write: if true; }
    match /about/{docId} { allow read, write: if true; }
    match /education/{docId} { allow read, write: if true; }
    match /skills/{docId} { allow read, write: if true; }
    match /projects/{docId} { allow read, write: if true; }
    match /experience/{docId} { allow read, write: if true; }
    match /certificates/{docId} { allow read, write: if true; }
    match /achievements/{docId} { allow read, write: if true; }
    match /leadership/{docId} { allow read, write: if true; }
    match /cv/{docId} { allow read, write: if true; }
    match /blog/{docId} { allow read, write: if true; }
    match /socials/{docId} { allow read, write: if true; }
    match /media/{docId} { allow read, write: if true; }
    match /messages/{docId} { allow read, write: if true; }
  }
}
